# Supabase project — Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side only, NEVER prefix with NEXT_PUBLIC_.
# Used by the admin API routes to bypass Row Level Security for writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login password for /card/admin (change this to something strong)
ADMIN_PASSWORD=change-me

# A random long string used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-too-a-long-random-string

# Public site URL, used to build QR codes and share links
NEXT_PUBLIC_SITE_URL=https://www.zanf.in
